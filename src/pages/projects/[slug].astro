---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[i + 1] ?? null },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.summary} links={false}>
  <div class="head">
    <a class="back muted" href="/projects/">← projects</a>
    <h1>{project.data.title}</h1>
    <p class="meta">
      <span class="stack">"{project.data.stack.join(', ')}"</span>
      <span class="muted"><span aria-hidden="true">//</span> {project.data.org}</span>
    </p>
  </div>

  <div class="prose">
    <Content />
  </div>

  {project.data.galleries.map((g) => <Gallery heading={g.heading} folder={g.folder} note={g.note} />)}

  <nav class="pager muted" aria-label="Project navigation">
    <a href="/projects/">← projects</a>
    {next && <a href={`/projects/${next.id}/`}>next: {next.data.title} →</a>}
  </nav>
</Base>

<Lightbox />

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .back {
    font-size: 13px;
    text-decoration: none;
    align-self: flex-start;
  }

  h1 {
    font-size: 28px;
    line-height: 1.25;
  }

  .meta {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 13px;
    line-height: 1.5;
  }

  .stack {
    color: var(--str);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-wrap: pretty;
  }

  .prose :global(p) {
    margin: 0;
  }

  .prose :global(ul) {
    margin: -6px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prose :global(figure) {
    margin: 0;
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--line);
  }

  .prose :global(figcaption) {
    font-size: 13px;
    line-height: 1.5;
    margin-top: 8px;
    color: var(--muted);
  }

  .pager {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .pager a {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 24px;
    }
  }
</style>
