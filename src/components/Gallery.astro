---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  heading: string;
  folder: string; // relative to src/assets/projects, non-recursive
  note?: string;
}

const { heading, folder, note } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
  { eager: true },
);

const base = `/src/assets/projects/${folder}/`;
const entries = Object.entries(all)
  .filter(([path]) => path.startsWith(base) && !path.slice(base.length).includes('/'))
  .sort(([a], [b]) => a.localeCompare(b));

if (entries.length === 0) {
  throw new Error(`Gallery folder has no images: src/assets/projects/${folder}`);
}

const altFromPath = (path: string) =>
  path
    .slice(base.length)
    .replace(/\.[^.]+$/, '')
    .replace(/[-_]+/g, ' ')
    .trim();

const images = await Promise.all(
  entries.map(async ([path, mod]) => ({
    alt: altFromPath(path),
    thumb: mod.default,
    full: await getImage({
      src: mod.default,
      width: Math.min(1600, mod.default.width),
      format: 'webp',
    }),
  })),
);
---

<section class="gallery">
  <h2 class="muted"><span aria-hidden="true">//</span> {heading}</h2>
  {note && <p class="note muted">{note}</p>}
  <ul class="grid" role="list">
    {
      images.map(({ alt, thumb, full }) => (
        <li>
          <a href={full.src} data-lightbox data-alt={alt} aria-label={`Open ${alt}`}>
            <Image src={thumb} width={440} height={440} fit="cover" alt={alt} loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h2 {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
  }

  .note {
    font-size: 14px;
    line-height: 1.6;
    margin-top: -4px;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .grid a {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
