---
import { links } from '../site';

interface Props {
  rule?: boolean;
}

const { rule = false } = Astro.props;
---

<footer class:list={['links', 'muted', { rule }]}>
  {
    links.map((link) => (
      <a
        href={link.href}
        rel={link.href.startsWith('http') ? 'me noopener' : undefined}
        target={link.href.startsWith('http') ? '_blank' : undefined}
      >
        {link.label}
      </a>
    ))
  }
</footer>

<style>
  .links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px 20px;
    font-size: 13px;
    padding-top: 4px;
  }

  .links.rule {
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .links a {
    text-decoration: none;
  }
</style>
